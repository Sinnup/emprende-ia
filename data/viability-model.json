{
  "model": "6-factor weighted viability score",
  "description": "Calculates business viability 0-100 based on Budget, Competition, Location, Security, Growth, Legal",
  "factors": {
    "budget": {
      "weight": 0.15,
      "name": "Capital Availability",
      "scoring": {
        "sufficient": 15,
        "marginal": 10,
        "insufficient": 3
      },
      "logic": "Compare user capital vs first-year total costs"
    },
    "competition": {
      "weight": 0.20,
      "name": "Market Saturation",
      "scoring": {
        "low": 20,
        "medium": 15,
        "high": 8,
        "very_high": 3
      },
      "logic": "Businesses per 10k population: <20=low, 20-50=medium, 50-100=high, >100=very_high"
    },
    "location": {
      "weight": 0.20,
      "name": "Foot Traffic & Accessibility",
      "scoring": {
        "high": 20,
        "medium": 15,
        "low": 8
      },
      "logic": "Daily foot traffic: >5000=high, 2000-5000=medium, <2000=low"
    },
    "security": {
      "weight": 0.15,
      "name": "Crime Risk",
      "scoring": {
        "low": 15,
        "medium": 10,
        "high": 3
      },
      "logic": "Crime index by zone + business type: <40=low, 40-70=medium, >70=high"
    },
    "growth": {
      "weight": 0.15,
      "name": "Zone Economic Growth",
      "scoring": {
        "growing": 15,
        "stable": 10,
        "declining": 5
      },
      "logic": "Annual growth rate: >2%=growing, 1-2%=stable, <1%=declining"
    },
    "legal": {
      "weight": 0.15,
      "name": "Regulatory Feasibility",
      "scoring": {
        "all_attainable": 15,
        "some_blockers": 10,
        "major_blockers": 3
      },
      "logic": "Can all required procedures be completed? Any blockers?"
    }
  },
  "interpretation": {
    "80-100": {"label": "Highly Viable", "description": "Strong indicators, likely success", "recommendation": "Proceed with caution, strong foundation"},
    "65-79": {"label": "Viable", "description": "Moderate risk, feasible", "recommendation": "Proceed, monitor risks"},
    "50-64": {"label": "Marginal", "description": "High risk, viability uncertain", "recommendation": "Needs careful planning, consider alternatives"},
    "0-49": {"label": "Not Recommended", "description": "Multiple red flags", "recommendation": "Reconsider location or business type"}
  }
}
